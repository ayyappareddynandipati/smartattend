# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored — never commit it.

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SMTP settings for attendance e-mails (optional).
# If left empty, e-mails are printed to the console instead of being sent.
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
